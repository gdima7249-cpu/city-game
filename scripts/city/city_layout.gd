class_name CityLayout
extends RefCounted
## Схема города. Её можно править прямо здесь: город строится по ней при запуске.
##
## Каждая буква — один квартал:
##   D — деловой центр: высотки
##   R — жилой район: дома пониже, во дворах трава и деревья
##   I — промзона и порт: склады и контейнеры
##   P — большой парк: соседние клетки P сливаются, дорог между ними нет
##   p — сквер: трава, дорожки, деревья
##   S — площадь с фонтаном
##   L — парковка
##   W — вода (залив). Вдоль воды идёт набережная с ограждением.
## Строки идут с севера на юг, буквы в строке — с запада на восток.
## Все строки должны быть одной длины.
const MAP: Array[String] = [
	"IIIRRRRPpW",
	"IIIRRRRPpW",
	"IILDDRRRpW",
	"RRDDDDRRpW",
	"RRDDSDLRpW",
	"RPPDDDDRpW",
	"RPPDDRRRpW",
	"RRRRRRIIIW",
	"RRLRRIIIIW",
	"IIIRRIIIIW",
]

## Ширина кварталов с запада на восток, по одному числу на столбец букв (метры).
const BLOCK_WIDTHS: Array[float] = [80, 65, 60, 50, 50, 50, 55, 60, 40, 150]

## Глубина кварталов с севера на юг, по одному числу на строку букв (метры).
const BLOCK_DEPTHS: Array[float] = [60, 55, 55, 50, 50, 50, 55, 55, 60, 65]

## Ширина дорог, идущих с севера на юг. Чисел на одно больше, чем столбцов:
## первое — дорога у западного края города, последнее — у восточного.
## 16 м и шире — проспект с двумя полосами в каждую сторону, 11 — обычная улица, 9 — узкая.
const ROADS_NS: Array[float] = [16, 11, 9, 11, 16, 11, 11, 9, 11, 16, 11]

## Ширина дорог, идущих с запада на восток. Чисел на одно больше, чем строк:
## первое — дорога у северного края города, последнее — у южного.
const ROADS_EW: Array[float] = [16, 9, 11, 11, 16, 11, 11, 9, 11, 11, 16]

## Ширина тротуара в каждом районе (метры).
const SIDEWALK := {"D": 4.0, "R": 3.0, "I": 2.0, "P": 3.0, "p": 3.0, "S": 4.0, "L": 2.0}


## Клетки этих типов сливаются с соседними такими же: дороги между ними нет.
static func merges(a: String, b: String) -> bool:
	return a == b and (a == "P" or a == "W")
